{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Dawn",
  "colors": {
    "primary": "#F84616",
    "light": "#F84616",
    "dark": "#F84616"
  },
  "favicon": {
    "light": "/images/favicon.svg",
    "dark": "/images/favicon.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "tabs": [
      {
        "tab": "Start Here",
        "groups": [
          {
            "group": "Get Started",
            "icon": "rocket",
            "pages": [
              "quickstart",
              "chains",
              "fees"
            ]
          }
        ]
      },
      {
        "tab": "Trading",
        "groups": [
          {
            "group": "Trading",
            "icon": "chart-candlestick",
            "pages": [
              "trading/trending",
              "trading/token-panel",
              "trading/buy-and-sell",
              "trading/multi-wallet",
              "trading/execution",
              "trading/portfolio",
              "trading/activity",
              "trading/pnl-cards"
            ]
          },
          {
            "group": "Automated Orders",
            "icon": "crosshairs",
            "pages": [
              "orders/overview",
              "orders/limit",
              "orders/ladder",
              "orders/dca",
              "orders/tp-sl",
              "orders/manage"
            ]
          }
        ]
      },
      {
        "tab": "Account",
        "groups": [
          {
            "group": "Wallets & Profiles",
            "icon": "wallet",
            "pages": [
              "wallets/wallets",
              "wallets/profiles",
              "wallets/import-export",
              "wallets/security"
            ]
          },
          {
            "group": "Funding",
            "icon": "arrow-right-arrow-left",
            "pages": [
              "funds/deposit",
              "funds/withdraw",
              "funds/move-to-balance"
            ]
          },
          {
            "group": "Settings",
            "icon": "sliders",
            "pages": [
              "settings/overview",
              "settings/guardrails",
              "settings/presets"
            ]
          }
        ]
      },
      {
        "tab": "Rewards",
        "groups": [
          {
            "group": "Rewards",
            "icon": "gift",
            "pages": [
              "rewards/overview",
              "rewards/cashback",
              "rewards/referrals",
              "rewards/tiers",
              "rewards/codes",
              "rewards/pump-fun"
            ]
          },
          {
            "group": "Sharing & Groups",
            "icon": "users",
            "pages": [
              "social/share-links",
              "social/group-links",
              "social/groups"
            ]
          }
        ]
      },
      {
        "tab": "Help",
        "groups": [
          {
            "group": "Help",
            "icon": "life-ring",
            "pages": [
              "help/commands",
              "help/troubleshooting",
              "help/glossary",
              "help/support"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "href": "https://dawn.trade",
        "label": "Website"
      },
      {
        "label": "Support",
        "href": "https://t.me/DawnContactBot"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Dawn",
      "href": "https://t.me/DawnTradeBot"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/dawndottrade",
      "telegram": "https://t.me/DawnTradeBot",
      "website": "https://dawn.trade"
    }
  },
  "description": "Dawn is a Telegram trading bot for memecoins. One USDC balance, six chains, no gas and no bridging to manage.",
  "logo": {
    "light": "/images/Orange-LogoOnly.png",
    "dark": "/images/Orange-LogoOnly.png"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#111111"
    }
  },
  "fonts": {
    "family": "Inter"
  },
  "styling": {
    "codeblocks": "system"
  }
}
